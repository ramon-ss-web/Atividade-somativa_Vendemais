# ---------------------------------------------------------------------------
# VendeMais Lead Enrichment — .env.example
# ---------------------------------------------------------------------------
# Stack C (Make.com): a MAIORIA das credenciais vive como "Connections" dentro
# do Make (HubSpot OAuth, OpenAI API key, Airtable PAT, Google CSE key) e NAO
# fica neste arquivo.
#
# Este .env atende a DOIS usos:
#   1) Pipeline CI/CD que versiona o blueprint do Make via API.
#   2) Mirror n8n local (n8n-mirror/) quando voce quiser apontar credenciais
#      reais nos nodes em vez de digitar na UI.
#
# Este template pode ser versionado; mantenha valores vazios ou ficticios.
# Nunca versione um arquivo .env preenchido com credenciais reais.
# ---------------------------------------------------------------------------

# --- Make.com API (baixar/subir blueprint via GitHub Actions) ---
MAKE_API_KEY=
MAKE_TEAM_ID=
MAKE_SCENARIO_ID=

# --- GitHub (commits automaticos do blueprint exportado) ---
GITHUB_TOKEN=

# --- Mirror n8n (opcional; conta CORPORATIVA, nao a pessoal) ---
OPENAI_API_KEY=
# Alternativa ao OpenAI: Anthropic Claude
ANTHROPIC_API_KEY=
# Nomes usados pelo docker-compose do mirror n8n.
HUBSPOT_ACCESS_TOKEN=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
HUBSPOT_PRIVATE_APP_TOKEN=

# --- n8n local ---
TZ=America/Sao_Paulo
